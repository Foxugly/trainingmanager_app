<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires runtime grant; requested in MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
            android:name=".TrainingManagerApplication"
            android:allowBackup="false"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network_security_config"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Sentry crash/error reporting (OPERATIONS.md §3.8). Initialised manually
             in TrainingManagerApplication, only when a DSN is built in
             (TM_SENTRY_DSN), never by its auto-init ContentProvider. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- Pushes rendered by the FCM SDK itself (app in background) use the app's
             monochrome icon and channel, not the defaults. -->
        <meta-data
                android:name="com.google.firebase.messaging.default_notification_icon"
                android:resource="@drawable/ic_stat_notification" />
        <meta-data
                android:name="com.google.firebase.messaging.default_notification_channel_id"
                android:value="tm_default" />

        <activity
                android:exported="true"
                android:launchMode="singleTop"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The trainingmanager:// custom scheme is DEBUG-only (src/debug/AndroidManifest.xml):
                 any web page or app can fire a custom scheme, so release builds only accept
                 the verified HTTPS App Links below. -->
            <!-- HTTPS App Links. autoVerify requires /.well-known/assetlinks.json hosted on
                 tm.foxugly.com with this app's release signing SHA-256 (OPS prerequisite). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="tm.foxugly.com" android:pathPrefix="/auth/magic-link/"/>
                <data android:scheme="https" android:host="tm.foxugly.com" android:pathPrefix="/auth/confirm-email/"/>
                <data android:scheme="https" android:host="tm.foxugly.com" android:pathPrefix="/auth/reset-password/"/>
                <data android:scheme="https" android:host="tm.foxugly.com" android:pathPrefix="/invitation/"/>
            </intent-filter>
        </activity>

        <!-- FCM push receiver. -->
        <service
                android:name=".TMFirebaseMessagingService"
                android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>

</manifest>
